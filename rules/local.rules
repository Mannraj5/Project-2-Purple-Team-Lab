# Purple Team Lab — Snort 3 detection ruleset
#
# Custom signatures written against traffic generated in this lab.
# SIDs 1,000,000+ (local range). Snort 3.12.2 syntax.
#
# Deploy:  sudo cp local.rules /etc/snort/rules/local.rules
# Verify:  sudo snort -c /etc/snort/snort.lua -R /etc/snort/rules/local.rules --warn-all -T
# Replay:  snort -c /etc/snort/snort.lua -R /etc/snort/rules/local.rules \
#                -r <capture.pcap> -A alert_fast -q
#
# Note on rule direction: in this lab both attacker and victim sit inside
# HOME_NET, so the $EXTERNAL_NET -> $HOME_NET convention that public rulesets
# assume does not apply. These rules key on behaviour and content instead.
#
# ---------------------------------------------------------------------------
# Rule 0 — pipeline validation only. Fires on every TCP packet; produced 137
# alerts against a single 493-packet intrusion. Retained commented as evidence
# of why untuned rules are operationally useless.
#
# alert tcp any any -> any any ( msg:"LAB-TEST TCP connection detected"; sid:1000000; rev:1; )
# ---------------------------------------------------------------------------


# --- RECONNAISSANCE --------------------------------------------------------

# 1 — ICMP echo burst, indicative of a host sweep.
#     Threshold is a first guess and expected to need tuning against the
#     baseline, which is ICMP-heavy by construction.
alert icmp any any -> $HOME_NET any (
    msg:"LAB-RECON ICMP echo request burst (possible host sweep)";
    itype:8;
    detection_filter:track by_src, count 15, seconds 5;
    sid:1000001; rev:1; )

# 2 — TCP SYN scan. Rate-based: a single SYN is normal, thirty in five
#     seconds from one source is not.
alert tcp any any -> $HOME_NET any (
    msg:"LAB-RECON TCP SYN scan";
    flags:S;
    detection_filter:track by_src, count 30, seconds 5;
    sid:1000002; rev:1; )


# --- DELIVERY --------------------------------------------------------------

# 3 — Executable requested over HTTP. Catches the Chain A dropper being
#     pulled from the attacker's web server.
alert tcp any any -> any 80 (
    msg:"LAB-DELIVERY executable requested over HTTP";
    flow:to_server,established;
    content:"GET";
    content:".exe", nocase;
    sid:1000003; rev:1; )


# --- EXPLOITATION ----------------------------------------------------------

# 4 — SMBv1 Trans2 request, the vehicle for MS17-010 exploitation.
#     Offset 4 skips the NetBIOS session header; 0xFF 'S' 'M' 'B' is the SMB1
#     header and 0x32 is SMB_COM_TRANSACTION2.
alert tcp any any -> $HOME_NET 445 (
    msg:"LAB-EXPLOIT SMBv1 Trans2 request (possible MS17-010)";
    flow:to_server,established;
    content:"|FF|SMB|32|", offset 4, depth 5;
    sid:1000004; rev:1; )


# --- COMMAND AND CONTROL ---------------------------------------------------

# 5 — Meterpreter callback, PORT-SPECIFIC. Deliberately brittle: this matches
#     Chain A on 4444 and misses Chain B on 5555 despite an identical payload.
#     Retained precisely to demonstrate that failure. Do not "fix" it.
alert tcp $HOME_NET any -> $HOME_NET 4444 (
    msg:"LAB-C2 Meterpreter callback to TCP 4444 (port-specific)";
    flow:to_server;
    sid:1000005; rev:1; )

# 6 — PE executable transferred over TCP, PORT-AGNOSTIC. Matches on content
#     rather than port, so it should catch the 199,238-byte Meterpreter stage
#     on both chains regardless of C2 port. This is the control against rule 5.
alert tcp any any -> any any (
    msg:"LAB-C2 PE executable transferred over TCP (possible payload stage)";
    flow:established;
    content:"MZ";
    content:"This program cannot be run in DOS mode";
    sid:1000006; rev:1; )
